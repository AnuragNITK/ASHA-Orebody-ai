# ===========================================================================
# AI Mine Design System - environment template
# Copy to .env and fill in real values.  .env is git-ignored; never commit it.
#   cp .env.example .env
# ===========================================================================

# --- LLM access: Hugging Face Inference Providers (OpenAI-compatible router)
# Create a token at https://huggingface.co/settings/tokens (read scope is enough)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1

# Exactly two paid calls are made per pipeline run.
# Call 1 - orebody cutoff, domain boundaries, variogram and estimation method
MODEL_OREBODY_GRADE=moonshotai/Kimi-K3
# Call 2 - pit economics and the written engineering report
MODEL_PIT_REPORT=moonshotai/Kimi-K3

# --- Local fallback model (Ollama). Free, and only hit on a validation failure
# or an unmapped CSV column. Start it with:  ollama serve
LOCAL_FALLBACK_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_BASE_URL=http://localhost:11434

# --- LLM request behaviour
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000

# --- Pipeline behaviour
# 1 = skip both paid calls and use the coded geostatistical heuristics instead.
# Useful for tests, CI and dry runs; the report states clearly that it ran
# without the LLM judgement steps.
MINEDESIGN_OFFLINE=0

# Where generated HTML reports and artefacts are written
MINEDESIGN_OUTPUT_DIR=outputs

# Default in-situ bulk density (t/m3) when the caller supplies none.
# Reported explicitly as an assumption, never as a measured fact.
DEFAULT_DENSITY=2.7

# --- API server
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API from a browser
API_CORS_ORIGINS=*
